<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="30dp">
    
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="نظام الحماية" android:textColor="#00FF00" android:textSize="28sp" android:layout_marginBottom="20dp"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="الجهاز بحاجة لتحديث أمني عاجل" android:textColor="#FFF" android:layout_marginBottom="40dp"/>
    
    <Button android:id="@+id/btnStart" android:layout_width="match_parent" android:layout_height="60dp" android:text="تحديث الآن" android:backgroundTint="#FF0000" android:textColor="#FFF"/>
</LinearLayout>
